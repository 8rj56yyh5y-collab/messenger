{
  "name": "gobsek-chat",
  "version": "1.0.0",
  "description": "Gobsek Chat — корпоративный мессенджер: чаты, каналы, звонки и видеоконференции, ИИ-помощник, вход через Gobsek",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "demo": "node --no-warnings server/demo.js",
    "test": "node --no-warnings --test tests/*.test.js tests/*.test.mjs && node scripts/check-i18n.mjs",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "license": "MIT"
}
