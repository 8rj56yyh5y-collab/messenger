# Скопируйте в .env.local и заполните. Файл .env.local в git не попадает.
PORT=3000
DATA_DIR=./data
COMPANY_NAME=Gobsek

# Первый администратор (иначе — мастер первого запуска в браузере)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# За HTTPS-прокси
# COOKIE_SECURE=1
# TRUST_PROXY=1

# ИИ-помощник (Claude)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Вход через Gobsek
# GOBSEK_SSO_SECRET=
# GOBSEK_SSO_URL=https://gobsek.example/app/chat-sso
# GOBSEK_URL=https://gobsek.example/app/

# Звонки через TURN (coturn, use-auth-secret)
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
